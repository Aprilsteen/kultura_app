<?xml version='1.0' encoding='utf-8'?>
<widget id="com.kultura.app" version="1.0.4" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Культура дома</name>
    <!--<icon src="res/images/icons/logo.png" />-->
    <description>Культура дома - уникальные товары для дома</description>
    <author email="info@td-kd.ru">
        Культура дома
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <allow-navigation href="http://*/*" />
    <allow-navigation href="https://*/*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="AndroidXEnabled" value="true" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/images/icons/splash-screen.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:icon="@mipmap/icon" android:roundIcon="@mipmap/icon_round" />
        </edit-config>
        <resource-file src="res/google-services.json" target="app/google-services.json" />
        <config-file parent="/manifest" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.RECORD_AUDIO" />
            <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
        </config-file>
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <preference name="AndroidPersistentFileModeEnabled" value="false" />
        <preference name="EnableViewportScale" value="true" />
        <preference name="android-windowSoftInputMode" value="adjustPan" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <preference name="WKWebViewOnly" value="true" />
        <feature name="CDVWKWebViewEngine">
            <param name="ios-package" value="CDVWKWebViewEngine" />
        </feature>
        <preference name="CordovaWebViewEngine" value="CDVWKWebViewEngine" />
        <preference name="AllowInlineMediaPlayback" value="true" />
        <preference name="allowsInlineMediaPlayback" value="true" />
        <preference name="MediaPlaybackAllowsInline" value="true" />
        <preference name="MediaTypesRequiringUserActionForPlayback" value="all" />
        <resource-file src="res/GoogleService-Info.plist" />
        <config-file parent="NSMicrophoneUsageDescription" target="*-Info.plist">
            <string>Приложению нужен доступ к микрофону для записи голосовых сообщений в чате</string>
        </config-file>
        <preference name="EnableViewportScale" value="true" />
        <preference name="AllowNewWindows" value="true" />
        <preference name="AutoHideSplashScreen" value="true" />
        <preference name="AllowsAirPlayForMediaPlayback" value="true" />
        <allow-navigation href="https://kultura-doma.ru/*" />
        <edit-config target="NSAppTransportSecurity" file="*-Info.plist" mode="merge">
            <dict>
                <key>NSAllowsArbitraryLoads</key>
                <true/>
                <key>NSAllowsArbitraryLoadsInWebContent</key>
                <true/>
                <key>NSAllowsLocalNetworking</key>
                <true/>
            </dict>
        </edit-config>
        <preference name="LimitsNavigationsToAppBoundDomains" value="false" />
        <edit-config target="WKAppBoundDomains" file="*-Info.plist" mode="merge">
            <array>
                <string>kultura-doma.ru</string>
            </array>
        </edit-config>
        <preference name="PreferredContentMode" value="mobile" />
        <preference name="AllowUntrustedCerts" value="true" />
        <preference name="InspectableWebview" value="false" />
        <preference name="deployment-target" value="15.0" />
    </platform>
    <platform name="browser">
        <preference name="AutoHideSplashScreen" value="true" />
    </platform>
    <preference name="LoadUrlTimeoutValue" value="700000" />
    <preference name="StatusBarOverlaysWebView" value="true" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="StatusBarBackgroundColor" value="#fff" />
    <preference name="ShowSplashScreen" value="false" />
    <preference name="SplashScreenDelay" value="400" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="SplashShowOnlyFirstTime" value="false" />
    <preference name="SplashScreenBackgroundColor" value="#fff" />
</widget>
